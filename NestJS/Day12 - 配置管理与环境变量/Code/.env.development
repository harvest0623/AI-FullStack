# ============================================================
# Day12 开发环境配置
# 当 NODE_ENV=development 或未指定时优先加载
# ============================================================

NODE_ENV=development
APP_NAME=nest-day12-config-demo
APP_PORT=3000
APP_PREFIX=api/v1

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=nest_day12_dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nest_day12_dev
DATABASE_SYNC=true

JWT_SECRET=dev-only-secret-please-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

LOG_LEVEL=debug
