# ============================================================
# Day12 生产环境配置
# 当 NODE_ENV=production 时加载
#
# 注意：生产环境的真实密钥应由 CI/CD 或运维平台注入
#       不要把生产密钥写死在仓库里
# ============================================================

NODE_ENV=production
APP_NAME=nest-day12-config-demo
APP_PORT=8080
APP_PREFIX=api/v1

DATABASE_HOST=prod-db.internal
DATABASE_PORT=5432
DATABASE_USERNAME=app_user
DATABASE_PASSWORD=REPLACE_VIA_CI_SECRET
DATABASE_NAME=nest_day12_prod
DATABASE_URL=postgresql://app_user:REPLACE_VIA_CI_SECRET@prod-db.internal:5432/nest_day12_prod
DATABASE_SYNC=false

JWT_SECRET=REPLACE_VIA_CI_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

LOG_LEVEL=warn
