# ============================================================
# Day12 默认环境配置（开发环境）
# 仅用于本地开发，请勿提交真实密钥到 git 仓库
# ============================================================

# 应用配置
NODE_ENV=development
APP_NAME=nest-day12-config-demo
APP_PORT=3000
APP_PREFIX=api/v1

# 数据库配置（演示用 SQLite 占位，Day13 会接入 TypeORM）
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=nest_day12_dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nest_day12_dev
DATABASE_SYNC=true

# JWT 配置（Day14 鉴权会使用）
JWT_SECRET=dev-only-secret-please-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# 日志配置
LOG_LEVEL=debug
