# ============================================================
# NestJS Day15 应用环境变量样例
# 使用方法：cp .env.example .env 然后按需修改
# 遵循 12-Factor App：所有环境差异通过环境变量注入，代码不变
# ============================================================

# ---- 运行环境 ----
NODE_ENV=development
PORT=3000

# ---- 全局前缀 ----
API_PREFIX=api/v1

# ---- CORS 白名单（逗号分隔）----
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# ---- 限流（Throttler）----
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ---- 上传文件 ----
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_DEST=./uploads

# ---- 日志 ----
LOG_LEVEL=debug
LOG_DIR=./logs

# ---- 数据库（演示用，未在代码中直连）----
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=123456
DB_DATABASE=nest_demo

# ---- Redis（演示用，未在代码中直连）----
REDIS_HOST=localhost
REDIS_PORT=6379
