# JWT 密钥与过期时间配置示例
# 复制为 .env 后填入真实值，切勿将 .env 提交到仓库
# 生成强随机密钥：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# JWT 签名密钥（生产环境必须使用 256 位以上强随机字符串）
JWT_SECRET=please-replace-with-a-strong-random-secret-at-least-32-chars-long

# Access Token 过期时间（短期，建议 15 分钟 ~ 1 小时）
JWT_EXPIRES_IN=15m

# Refresh Token 过期时间（长期，建议 7 ~ 30 天）
JWT_REFRESH_EXPIRES_IN=7d

# 应用监听端口
PORT=3000
