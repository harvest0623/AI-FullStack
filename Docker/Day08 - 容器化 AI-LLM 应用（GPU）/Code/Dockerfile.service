# 封装你自己的 Python 推理服务的 Dockerfile 参考
# 说明：这里展示一个"把 fastapi 推理服务打包"的模板。
# 用法：docker build -f Dockerfile.service -t mysvc:1.0 .

# 基础镜像：Python + 系统库（推理常用 CUDA 基础可换成 nvidia/cuda）
FROM python:3.11-slim

WORKDIR /app

# 系统依赖（编译类包可能需要）
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
 && rm -rf /var/lib/apt/lists/*

# 依赖在前，利用层缓存
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# 业务代码在后
COPY app.py ./model/ ./query.py ./

# 非 root 运行（安全最佳实践）
RUN useradd -m appuser \
 && chown -R appuser:appuser /app
USER appuser

# 端口与环境
EXPOSE 8000
ENV MODEL_PATH=/models/model.bin

# 启动
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]