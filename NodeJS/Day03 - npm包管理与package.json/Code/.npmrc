# ------------------------------------------------------------------
# .npmrc - npm 行为配置文件
# ------------------------------------------------------------------
# 作用：随项目提交，保证团队成员、CI、Docker 使用一致的 registry
#       与安装策略。命令行 `npm config set xxx` 写入的是用户级
#       ~/.npmrc，不会进版本库；项目级 .npmrc 优先级更高。
# ------------------------------------------------------------------

# 1) 默认 registry：使用淘宝镜像加速（国内推荐）
registry=https://registry.npmmirror.com/

# 2) scope 分流示例：
#    @company 走私有 registry，其他包仍走公共镜像
# @company:registry=https://npm.company.com/

# 3) 私有 registry 鉴权 token（敏感，请勿提交真实值！）
#    推荐通过 CI 环境变量注入，本地用 dotenv 或 npm login 生成
# //npm.company.com/:_authToken=${COMPANY_NPM_TOKEN}

# 4) 严格校验 engines 字段（拒绝在低版本 Node 上安装）
# engine-strict=true

# 5) 严格校验 lock 与 package.json 一致性（CI 友好）
# package-lock=true

# 6) 控制是否保存依赖到 package.json（默认 true）
# save=true

# 7) 网络超时（毫秒），国内网络抖动时调大
# fetch-timeout=60000

# 8) 限制并发请求数，弱网机器可调小
# maxsockets=5

# 9) 关闭进度条（CI 日志更干净）
# progress=false

# ------------------------------------------------------------------
# 注意：本文件以 # 开头的行为注释。.npmrc 实际生效行格式为
#       key=value，且 key 区分大小写。
# ------------------------------------------------------------------
