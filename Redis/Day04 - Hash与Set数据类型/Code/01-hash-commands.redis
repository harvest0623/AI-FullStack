ECHO "============================================================"
ECHO "文件名称: 01-hash-commands.redis"
ECHO "文件用途: Hash 类型全部命令演示"
ECHO "          HSET/HGET/HGETALL、HINCRBY、HRANDFIELD、HSCAN"
ECHO "          应用场景：商品信息 cache:product:1、购物车 cart:1001、用户信息 cache:user:1"
ECHO "执行方式: redis-cli < 01-hash-commands.redis"
ECHO "============================================================"

ECHO ""
ECHO "=== 0. 清空当前库 ==="
FLUSHDB

ECHO ""
ECHO "=== 1. HSET 单字段写入（商品信息）==="
HSET cache:product:1 name "iPhone 15"
HSET cache:product:1 price "5999"
HSET cache:product:1 stock "1000"
ECHO "查看类型"
TYPE cache:product:1

ECHO ""
ECHO "=== 2. HSET 批量写入多个字段（4.0+ 支持）==="
HSET cache:product:2 name "MacBook Pro" price "12999" stock "500" brand "Apple"

ECHO ""
ECHO "=== 3. HGET 读取单字段 ==="
HGET cache:product:1 name
HGET cache:product:1 price

ECHO ""
ECHO "=== 4. HMGET 批量读取多个字段（不存在的返回 nil）==="
HMGET cache:product:1 name price stock brand

ECHO ""
ECHO "=== 5. HGETALL 读取全部字段与值 ==="
HGETALL cache:product:1

ECHO ""
ECHO "=== 6. HKEYS 读取所有字段名 ==="
HKEYS cache:product:1

ECHO ""
ECHO "=== 7. HVALS 读取所有值 ==="
HVALS cache:product:1

ECHO ""
ECHO "=== 8. HLEN 字段数量 ==="
HLEN cache:product:1

ECHO ""
ECHO "=== 9. HEXISTS 判断字段是否存在 ==="
HEXISTS cache:product:1 name
HEXISTS cache:product:1 color

ECHO ""
ECHO "=== 10. HSETNX 仅当字段不存在时设置 ==="
HSETNX cache:product:1 name "iPhone 16"
HSETNX cache:product:1 color "Black"
HGET cache:product:1 name
HGET cache:product:1 color

ECHO ""
ECHO "=== 11. HINCRBY 字段整数递增（库存/计数）==="
HINCRBY cache:product:1 stock -1
HINCRBY cache:product:1 stock -5
HINCRBY cache:product:1 stock 100
HGET cache:product:1 stock

ECHO ""
ECHO "=== 12. HINCRBYFLOAT 字段浮点递增（价格微调）==="
HINCRBYFLOAT cache:product:1 price 0.50
HINCRBYFLOAT cache:product:1 price -100.00
HGET cache:product:1 price

ECHO ""
ECHO "=== 13. HDEL 删除字段 ==="
HDEL cache:product:1 color
HEXISTS cache:product:1 color

ECHO ""
ECHO "=== 14. HRANDFIELD 随机返回字段（6.2+）==="
HSET demo:hash f1 "v1" f2 "v2" f3 "v3" f4 "v4" f5 "v5"
ECHO "随机返回 1 个字段名"
HRANDFIELD demo:hash
ECHO "随机返回 2 个字段名"
HRANDFIELD demo:hash 2
ECHO "随机返回 2 个字段名 + 值"
HRANDFIELD demo:hash 2 WITHVALUES
ECHO "负数 count 允许重复返回"
HRANDFIELD demo:hash -3

ECHO ""
ECHO "=== 15. HSCAN 渐进扫描字段 ==="
HSCAN demo:hash 0 COUNT 100

ECHO ""
ECHO "=== 16. 应用场景一：用 Hash 存商品信息 cache:product:1 ==="
HSET cache:product:1001 name "iPhone 15 Pro" price "7999" stock "200" category "phone" brand "Apple"
ECHO "只读商品名与价格（HGET 高效）"
HMGET cache:product:1001 name price
ECHO "库存 -1（HINCRBY 原子扣减）"
HINCRBY cache:product:1001 stock -1
HGET cache:product:1001 stock

ECHO ""
ECHO "=== 17. 应用场景二：购物车 cart:1001（field=product_id, value=quantity）==="
ECHO "用户 1001 加购：商品 1001 数量 2，商品 1002 数量 1，商品 1003 数量 3"
HSET cart:1001 1001 2 1002 1 1003 3
ECHO "查看购物车"
HGETALL cart:1001
ECHO "商品 1001 再加 1 件（HINCRBY 原子加）"
HINCRBY cart:1001 1001 1
HGET cart:1001 1001
ECHO "商品 1001 减 3 件"
HINCRBY cart:1001 1001 -3
HGET cart:1001 1001
ECHO "商品 1002 移除购物车"
HDEL cart:1001 1002
ECHO "购物车剩余商品种类数"
HLEN cart:1001
ECHO "购物车当前内容"
HGETALL cart:1001
ECHO "判断商品 1003 是否在购物车"
HEXISTS cart:1001 1003
ECHO "判断商品 1002 是否在购物车（已移除）"
HEXISTS cart:1001 1002

ECHO ""
ECHO "=== 18. 应用场景三：用户信息 cache:user:1 ==="
HSET cache:user:1 name "Alice" email "alice@example.com" age "28" city "Beijing"
ECHO "读取用户全部信息"
HGETALL cache:user:1
ECHO "只更新年龄（HSET 单字段，无需重写整个对象）"
HSET cache:user:1 age "29"
HGET cache:user:1 age
ECHO "对比：若用 String 存 JSON，更新年龄需 GET-修改-SET 整个 JSON，开销大"

ECHO ""
ECHO "=== 19. 应用场景四：配置项存储 config:app ==="
HSET config:app max_login_retry "5" session_timeout "1800" enable_captcha "true"
HGETALL config:app
HGET config:app session_timeout

ECHO ""
ECHO "=== 20. OBJECT ENCODING 查看底层编码 ==="
OBJECT ENCODING cache:product:1
ECHO "小 Hash 为 listpack；字段多或值大时转为 hashtable"

ECHO ""
ECHO "=== 21. 对比：Hash 存对象 vs String 存 JSON ==="
ECHO "String 存 JSON"
SET cache:product:2001 '{"name":"iPad","price":3999,"stock":800}'
GET cache:product:2001
ECHO "更新价格需整体重写（GET-修改-SET）"
SET cache:product:2001 '{"name":"iPad","price":3899,"stock":800}'
ECHO "Hash 存对象：HSET 单字段即可，省带宽"
HSET cache:product:2002 name "iPad" price 3999 stock 800
HSET cache:product:2002 price 3899
HGETALL cache:product:2002

ECHO ""
ECHO "============================================================"
ECHO "Hash 类型演示完毕。"
ECHO "覆盖：HSET/HGET/HMGET/HGETALL/HKEYS/HVALS/HLEN"
ECHO "      HSETNX/HEXISTS/HDEL、HINCRBY/HINCRBYFLOAT"
ECHO "      HRANDFIELD/HSCAN、OBJECT ENCODING"
ECHO "      应用场景：商品信息、购物车、用户信息、配置项"
ECHO "      Hash 存对象 vs String 存 JSON 对比"
ECHO "============================================================"
