# ============================================================
# 文件用途：Bitmap 位图演示（用户签到 / 活跃统计 / 位运算）
# 场景：电商平台用户签到系统、连续活跃用户统计
# 执行方式：redis-cli < 01-bitmap-demo.redis
#           或进入 redis-cli 后逐行复制粘贴
# 适用版本：Redis 7.0+
# ============================================================

# 清理本次演示涉及的 Key
DEL sign:user:1:202501 sign:user:2:202501
DEL active:20250101 active:20250102 active:20250103 active:weekly
DEL online:users:20250128
DEL bf:demo


ECHO "=== 1. 用户签到：SETBIT / GETBIT 基础 ==="

ECHO "--- Key 设计：sign:user:{userId}:{yyyymm}，offset = 当月第几天 ---"

ECHO "--- 用户 1 在 1 月 1 日签到（offset = 1） ---"
SETBIT sign:user:1:202501 1 1

ECHO "--- 用户 1 在 1 月 3 日签到 ---"
SETBIT sign:user:1:202501 3 1

ECHO "--- 用户 1 在 1 月 5 日签到 ---"
SETBIT sign:user:1:202501 5 1

ECHO "--- 用户 1 在 1 月 10 日签到 ---"
SETBIT sign:user:1:202501 10 1

ECHO "--- 查询用户 1 在 1 月 3 日是否签到（1=已签，0=未签） ---"
GETBIT sign:user:1:202501 3

ECHO "--- 查询用户 1 在 1 月 4 日是否签到 ---"
GETBIT sign:user:1:202501 4


ECHO "=== 2. BITCOUNT 月签到总天数 ==="

ECHO "--- 用户 1 当月签到总天数（应为 4 天） ---"
BITCOUNT sign:user:1:202501


ECHO "=== 3. 连续签到天数计算 ==="

ECHO "--- 模拟用户 2 连续签到 1、2、3、4、5 日，第 6 日断签 ---"
SETBIT sign:user:2:202501 1 1
SETBIT sign:user:2:202501 2 1
SETBIT sign:user:2:202501 3 1
SETBIT sign:user:2:202501 4 1
SETBIT sign:user:2:202501 5 1

ECHO "--- 从第 5 日往前查连续签到天数（演示思路：逐位 GETBIT） ---"
GETBIT sign:user:2:202501 5
GETBIT sign:user:2:202501 4
GETBIT sign:user:2:202501 3
GETBIT sign:user:2:202501 2
GETBIT sign:user:2:202501 1
GETBIT sign:user:2:202501 0

ECHO "--- 实际工程中用 BITFIELD 一次取一段位更高效（这里取第 1-8 位为 u8） ---"
BITFIELD sign:user:2:202501 GET u8 1


ECHO "=== 4. BITOP 位运算：求多日活跃用户交集 ==="

ECHO "--- 模拟 3 天的用户活跃位图（offset = userId） ---"
ECHO "--- 第 1 天：用户 1、2、3、5 活跃 ---"
SETBIT active:20250101 1 1
SETBIT active:20250101 2 1
SETBIT active:20250101 3 1
SETBIT active:20250101 5 1

ECHO "--- 第 2 天：用户 1、2、4、5 活跃 ---"
SETBIT active:20250102 1 1
SETBIT active:20250102 2 1
SETBIT active:20250102 4 1
SETBIT active:20250102 5 1

ECHO "--- 第 3 天：用户 1、2、5、6 活跃 ---"
SETBIT active:20250103 1 1
SETBIT active:20250103 2 1
SETBIT active:20250103 5 1
SETBIT active:20250103 6 1

ECHO "--- AND 运算：3 天都活跃的用户（应为 1、2、5） ---"
BITOP AND active:weekly active:20250101 active:20250102 active:20250103

ECHO "--- 3 天都活跃的用户数（应为 3） ---"
BITCOUNT active:weekly

ECHO "--- OR 运算：3 天任一天活跃的用户数（应为 5：1/2/3/4/5/6 共 6 个） ---"
BITOP OR active:anyday active:20250101 active:20250102 active:20250103
BITCOUNT active:anyday

ECHO "--- XOR 运算：只在某一天活跃的用户（活跃天数奇偶性） ---"
BITOP XOR active:xor active:20250101 active:20250102
BITCOUNT active:xor


ECHO "=== 5. BITPOS 查找第一个 0/1 的位 ==="

ECHO "--- sign:user:2:202501 中第一个为 1 的位 ---"
BITPOS sign:user:2:202501 1

ECHO "--- sign:user:2:202501 中第一个为 0 的位 ---"
BITPOS sign:user:2:202501 0

ECHO "--- 限定范围：从第 3 字节开始查找第一个为 1 的位 ---"
BITPOS sign:user:2:202501 1 3


ECHO "=== 6. BITCOUNT 限定范围统计 ==="

ECHO "--- 统计 sign:user:2:202501 前 4 字节内为 1 的位数 ---"
BITCOUNT sign:user:2:202501 0 3

ECHO "--- 按 BIT 单位统计第 1 到第 31 位 ---"
BITCOUNT sign:user:2:202501 0 30 BIT


ECHO "=== 7. 在线用户统计：用 Bitmap 模拟 online:users:{date} ==="

ECHO "--- 模拟 1 月 28 日 6 个用户在线（offset = userId） ---"
SETBIT online:users:20250128 1 1
SETBIT online:users:20250128 2 1
SETBIT online:users:20250128 3 1
SETBIT online:users:20250128 100 1
SETBIT online:users:20250128 1000 1
SETBIT online:users:20250128 10000 1

ECHO "--- 1 月 28 日在线用户数 ---"
BITCOUNT online:users:20250128

ECHO "--- 查询用户 1000 是否在线 ---"
GETBIT online:users:20250128 1000

ECHO "--- 查询用户 9999 是否在线 ---"
GETBIT online:users:20250128 9999


ECHO "=== 8. BITFIELD 多位域操作：紧凑计数器 ==="

DEL counter:compact

ECHO "--- 一个 String 存 3 个 8 位计数器（offset 0、8、16） ---"
BITFIELD counter:compact SET u8 0 100
BITFIELD counter:compact SET u8 8 200
BITFIELD counter:compact SET u8 16 50

ECHO "--- 读取三个计数器 ---"
BITFIELD counter:compact GET u8 0 GET u8 8 GET u8 16

ECHO "--- 对第二个计数器 +30（INCRBY） ---"
BITFIELD counter:compact INCRBY u8 8 30
BITFIELD counter:compact GET u8 8

ECHO "--- 溢出策略演示：让计数器溢出，WRAP 表示环绕（默认） ---"
BITFIELD counter:compact OVERFLOW WRAP INCRBY u8 16 250

ECHO "--- SAT 表示饱和到最大值 255 ---"
BITFIELD counter:compact SET u8 0 200
BITFIELD counter:compact OVERFLOW SAT INCRBY u8 0 100
BITFIELD counter:compact GET u8 0

ECHO "--- FAIL 表示溢出时报错返回 nil ---"
BITFIELD counter:compact OVERFLOW FAIL INCRBY u8 0 100


ECHO "=== 9. 布隆过滤器模拟（用 Bitmap + 多哈希，简化演示） ==="

ECHO "--- 说明：真实布隆过滤器需要多个哈希函数，这里用简单取模演示原理 ---"
ECHO "--- 假设 3 个哈希函数：h1 = id % 100, h2 = (id*7) % 100, h3 = (id*13) % 100 ---"

ECHO "--- 添加元素 user:42（42 % 100 = 42, 42*7=294 % 100 = 94, 42*13=546 % 100 = 46） ---"
SETBIT bf:demo 42 1
SETBIT bf:demo 94 1
SETBIT bf:demo 46 1

ECHO "--- 添加元素 user:88（88, 88*7=616%100=16, 88*13=1144%100=44） ---"
SETBIT bf:demo 88 1
SETBIT bf:demo 16 1
SETBIT bf:demo 44 1

ECHO "--- 查询 user:42 是否可能存在（3 位都为 1 → 可能存在） ---"
GETBIT bf:demo 42
GETBIT bf:demo 94
GETBIT bf:demo 46

ECHO "--- 查询 user:99（99, 99*7=693%100=93, 99*13=1287%100=87） ---"
ECHO "--- 若 99 或 93 或 87 任一位为 0，则一定不存在 ---"
GETBIT bf:demo 99
GETBIT bf:demo 93
GETBIT bf:demo 87


ECHO "=== 10. 内存占用对比：Bitmap vs Set ==="

DEL online:set:20250128

ECHO "--- 用 Set 存同样的 6 个在线用户 ID ---"
SADD online:set:20250128 1 2 3 100 1000 10000

ECHO "--- Bitmap 内存占用 ---"
MEMORY USAGE online:users:20250128

ECHO "--- Set 内存占用 ---"
MEMORY USAGE online:set:20250128

ECHO "--- 结论：用户 ID 跨度大时 Bitmap 占用更稳定，Set 与元素数成正比 ---"


ECHO "=== 11. 清理演示数据 ==="

DEL sign:user:1:202501 sign:user:2:202501
DEL active:20250101 active:20250102 active:20250103 active:weekly active:anyday active:xor
DEL online:users:20250128 online:set:20250128
DEL bf:demo counter:compact

ECHO "=== Day06 Bitmap 演示完成 ==="
