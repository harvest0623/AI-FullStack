{
  "name": "typescript-day01",
  "version": "1.0.0",
  "description": "TypeScript Day01 示例：第一个 TS 程序、JS/TS 对比、编译运行流程演示",
  "main": "hello.ts",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "build": "tsc",
    "build:check": "tsc --noEmit",
    "start": "tsx hello.ts",
    "dev": "tsx watch hello.ts",
    "hello": "tsx hello.ts",
    "compare": "tsx types-vs-js.ts",
    "watch": "tsc --watch",
    "clean": "node -e \"require('fs').rmSync('./dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "ai-fullstack",
    "typescript",
    "learning",
    "day01"
  ],
  "author": "AI-FullStack Learner",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
